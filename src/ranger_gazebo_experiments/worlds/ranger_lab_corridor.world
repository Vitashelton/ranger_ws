<?xml version="1.0"?>
<sdf version="1.6">
  <world name="ranger_lab_corridor">
    <scene>
      <ambient>0.4 0.4 0.4 1.0</ambient>
      <background>0.7 0.8 0.9 1.0</background>
      <shadows>true</shadows>
    </scene>

    <!-- Sun light -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <model name="lab_floor">
      <static>true</static>
      <pose>0 0 -0.005 0 0 0</pose>
      <link name="floor_link">
        <visual name="floor_visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material>
            <ambient>0.5 0.45 0.4 1.0</ambient>
            <diffuse>0.5 0.45 0.4 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========== Corridor Walls ========== -->
    <!-- North wall -->
    <model name="wall_north">
      <static>true</static>
      <pose>5 3 1.25 0 0 0</pose>
      <link name="wall_link">
        <visual name="visual">
          <geometry><box><size>20 0.15 2.5</size></box></geometry>
          <material>
            <ambient>0.8 0.75 0.7 1.0</ambient>
            <diffuse>0.8 0.75 0.7 1.0</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>20 0.15 2.5</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- South wall -->
    <model name="wall_south">
      <static>true</static>
      <pose>5 -3 1.25 0 0 0</pose>
      <link name="wall_link">
        <visual name="visual">
          <geometry><box><size>20 0.15 2.5</size></box></geometry>
          <material>
            <ambient>0.8 0.75 0.7 1.0</ambient>
            <diffuse>0.8 0.75 0.7 1.0</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>20 0.15 2.5</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- West wall (with doorway) — two segments -->
    <model name="wall_west_top">
      <static>true</static>
      <pose>-3.5 0 1.25 0 0 0</pose>
      <link name="wall_link">
        <visual name="visual">
          <geometry><box><size>3 0.15 2.5</size></box></geometry>
          <material>
            <ambient>0.8 0.75 0.7 1.0</ambient>
            <diffuse>0.8 0.75 0.7 1.0</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>3 0.15 2.5</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="wall_west_bottom">
      <static>true</static>
      <pose>3.5 -2.5 1.25 0 0 0</pose>
      <link name="wall_link">
        <visual name="visual">
          <geometry><box><size>3 0.15 2.5</size></box></geometry>
          <material>
            <ambient>0.8 0.75 0.7 1.0</ambient>
            <diffuse>0.8 0.75 0.7 1.0</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>3 0.15 2.5</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- East wall (end of corridor) -->
    <model name="wall_east">
      <static>true</static>
      <pose>13.5 0 1.25 0 0 0</pose>
      <link name="wall_link">
        <visual name="visual">
          <geometry><box><size>0.15 6 2.5</size></box></geometry>
          <material>
            <ambient>0.8 0.75 0.7 1.0</ambient>
            <diffuse>0.8 0.75 0.7 1.0</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.15 6 2.5</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- ========== Static Obstacles ========== -->
    <!-- Table -->
    <model name="table_1">
      <static>true</static>
      <pose>8 1.5 0.375 0 0 0</pose>
      <link name="table_link">
        <visual name="visual">
          <geometry><box><size>1.5 0.8 0.05</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1.0</ambient></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>1.5 0.8 0.05</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Table legs -->
    <model name="table_1_legs">
      <static>true</static>
      <pose>8 1.5 0 0 0 0</pose>
      <link name="legs_link">
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.75</size></box></geometry>
          <material><ambient>0.4 0.3 0.2 1.0</ambient></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>1.4 0.7 0.75</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Box/crate -->
    <model name="crate_1">
      <static>true</static>
      <pose>6 -1.5 0.25 0 0 0</pose>
      <link name="crate_link">
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.7 0.5 0.1 1.0</ambient></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Chair -->
    <model name="chair_1">
      <static>true</static>
      <pose>10 1.8 0.45 0 0 0</pose>
      <link name="chair_link">
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.05</size></box></geometry>
          <material><ambient>0.2 0.2 0.3 1.0</ambient></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.5 0.5 0.9</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- ========== Low Obstacles (for D435i blind-zone test) ========== -->
    <model name="low_box_1">
      <static>true</static>
      <pose>9 0.3 0.1 0 0 0</pose>
      <link name="low_box_link">
        <visual name="visual">
          <geometry><box><size>0.3 0.3 0.2</size></box></geometry>
          <material><ambient>0.9 0.3 0.1 1.0</ambient></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.3 0.3 0.2</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Curb edge -->
    <model name="curb_edge_1">
      <static>true</static>
      <pose>7 0 0.05 0 0 0</pose>
      <link name="curb_link">
        <visual name="visual">
          <geometry><box><size>0.8 0.15 0.1</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1.0</ambient></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.8 0.15 0.1</size></box></geometry>
        </collision>
      </link>
    </model>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000.0</real_time_update_rate>
    </physics>
  </world>
</sdf>
