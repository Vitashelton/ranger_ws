    <model name="teacher_zhang"><static>true</static><pose>9.00 4.55 0.02 0 0 1.5708</pose>
      <link name="body"><collision name="body_collision"><pose>0 0 0.55 0 0 0</pose><geometry><cylinder><radius>0.20</radius><length>1.10</length></cylinder></geometry></collision><visual name="clothes"><pose>0 0 0.55 0 0 0</pose><geometry><cylinder><radius>0.22</radius><length>0.72</length></cylinder></geometry><material><ambient>0.55 0.35 0.78 1</ambient><diffuse>0.55 0.35 0.78 1</diffuse></material></visual><visual name="head"><pose>0 0 1.02 0 0 0</pose><geometry><sphere><radius>0.16</radius></sphere></geometry><material><ambient>0.92 0.74 0.60 1</ambient><diffuse>0.92 0.74 0.60 1</diffuse></material></visual></link>
      <plugin filename="libignition-gazebo-pose-publisher-system.so" name="ignition::gazebo::systems::PosePublisher"><publish_model_pose>true</publish_model_pose><use_pose_vector_msg>false</use_pose_vector_msg><update_frequency>10</update_frequency></plugin>
