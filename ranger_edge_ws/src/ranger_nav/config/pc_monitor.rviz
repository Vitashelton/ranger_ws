Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Cell Size: 0.5
      Alpha: 0.5
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Local Risk Grid
      Topic:
        Value: /local_risk_grid
      Alpha: 0.65
      Color Scheme: map
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Risk Markers
      Topic:
        Value: /debug/risk_markers
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Shared Control Markers
      Topic:
        Value: /debug/shared_control_markers
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: RangerMini Steering Modules
      Topic:
        Value: /debug/rangermini2_steer_modules
    - Class: rviz_default_plugins/Pose
      Enabled: true
      Name: Semantic Target
      Topic:
        Value: /semantic_target_pose
      Shape: Axes
      Shaft Length: 0.5
      Shaft Radius: 0.03
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: Odom
      Topic:
        Value: /odom
      Keep: 20
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 9
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 1.2
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1400
