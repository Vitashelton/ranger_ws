<?xml version="1.0"?>
<sdf version="1.9">
  <world name="dynamic_indoor_benchmark">
    <physics name="fast" type="ignored"><max_step_size>0.004</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="libignition-gazebo-physics-system.so" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="libignition-gazebo-user-commands-system.so" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <scene><ambient>0.82 0.82 0.82 1</ambient><background>0.92 0.94 0.97 1</background></scene>
    <light type="directional" name="ceiling_light"><pose>15 10 12 0 0 0</pose><diffuse>1 1 1 1</diffuse><direction>-0.25 0.15 -1</direction></light>

    <!-- 30 x 20 m facility.  A central service block creates two long routes;
         west/east junctions connect them into a loop, so a blocked edge has a
         genuine alternative instead of merely stopping the robot. -->
    <model name="floor"><static>true</static><pose>15 10 0 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>30 20 0.05</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>30 20 0.05</size></box></geometry><material><ambient>0.72 0.74 0.77 1</ambient><diffuse>0.72 0.74 0.77 1</diffuse></material></visual>
    </link></model>
    <model name="central_service_block"><static>true</static><pose>15 10 1.2 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>14 6 2.4</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>14 6 2.4</size></box></geometry><material><ambient>0.42 0.45 0.50 1</ambient><diffuse>0.42 0.45 0.50 1</diffuse></material></visual>
    </link></model>

    <!-- Outer walls, with broad west/east turning junctions. -->
    <model name="wall_s"><static>true</static><pose>15 0 1.2 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>30 .18 2.4</size></box></geometry></collision><visual name="v"><geometry><box><size>30 .18 2.4</size></box></geometry></visual></link></model>
    <model name="wall_n"><static>true</static><pose>15 20 1.2 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>30 .18 2.4</size></box></geometry></collision><visual name="v"><geometry><box><size>30 .18 2.4</size></box></geometry></visual></link></model>
    <model name="wall_w"><static>true</static><pose>0 10 1.2 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>.18 20 2.4</size></box></geometry></collision><visual name="v"><geometry><box><size>.18 20 2.4</size></box></geometry></visual></link></model>
    <model name="wall_e"><static>true</static><pose>30 10 1.2 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>.18 20 2.4</size></box></geometry></collision><visual name="v"><geometry><box><size>.18 20 2.4</size></box></geometry></visual></link></model>

    <!-- Zone dividers are short enough to retain manoeuvring space. -->
    <model name="office_zone_marker"><static>true</static><pose>9 19.5 .04 0 0 0</pose><link name="l"><visual name="v"><geometry><box><size>.15 1 .08</size></box></geometry><material><ambient>.2 .6 .9 1</ambient><diffuse>.2 .6 .9 1</diffuse></material></visual></link></model>
    <model name="storage_zone_marker"><static>true</static><pose>21 19.5 .04 0 0 0</pose><link name="l"><visual name="v"><geometry><box><size>.15 1 .08</size></box></geometry><material><ambient>.2 .6 .9 1</ambient><diffuse>.2 .6 .9 1</diffuse></material></visual></link></model>
    <model name="receiving_zone_marker"><static>true</static><pose>10 .5 .04 0 0 0</pose><link name="l"><visual name="v"><geometry><box><size>.15 1 .08</size></box></geometry></visual></link></model>
    <model name="loading_zone_marker"><static>true</static><pose>21 .5 .04 0 0 0</pose><link name="l"><visual name="v"><geometry><box><size>.15 1 .08</size></box></geometry></visual></link></model>

    <!-- Static shelves make the RGB-D and lidar views less toy-like. -->
    <model name="rack_a"><static>true</static><pose>25 18 0.9 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>3.8 .6 1.8</size></box></geometry></collision><visual name="v"><geometry><box><size>3.8 .6 1.8</size></box></geometry><material><ambient>.30 .32 .35 1</ambient><diffuse>.30 .32 .35 1</diffuse></material></visual></link></model>
    <model name="rack_b"><static>true</static><pose>25 14.5 0.9 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>3.8 .6 1.8</size></box></geometry></collision><visual name="v"><geometry><box><size>3.8 .6 1.8</size></box></geometry><material><ambient>.30 .32 .35 1</ambient><diffuse>.30 .32 .35 1</diffuse></material></visual></link></model>
    <model name="packing_table"><static>true</static><pose>15 2 0.45 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>3 1 0.9</size></box></geometry></collision><visual name="v"><geometry><box><size>3 1 0.9</size></box></geometry><material><ambient>.45 .32 .2 1</ambient><diffuse>.45 .32 .2 1</diffuse></material></visual></link></model>

    <!-- Coloured semantic assets: consumed through rendered RGB-D only. -->
    <model name="parcel_red"><static>true</static><pose>5.2 3.0 .35 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>.65 .55 .7</size></box></geometry></collision><visual name="v"><geometry><box><size>.65 .55 .7</size></box></geometry><material><ambient>.82 .18 .18 1</ambient><diffuse>.82 .18 .18 1</diffuse></material></visual></link></model>
    <model name="parcel_blue"><static>true</static><pose>16.0 3.1 .35 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>.65 .55 .7</size></box></geometry></collision><visual name="v"><geometry><box><size>.65 .55 .7</size></box></geometry><material><ambient>.14 .33 .86 1</ambient><diffuse>.14 .33 .86 1</diffuse></material></visual></link></model>
    <model name="mobile_cart"><static>true</static><pose>20.8 3 .45 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1.2 .75 .9</size></box></geometry></collision><visual name="v"><geometry><box><size>1.2 .75 .9</size></box></geometry><material><ambient>.92 .57 .10 1</ambient><diffuse>.92 .57 .10 1</diffuse></material></visual></link></model>
    <model name="inspection_panel"><static>true</static><pose>14 18.8 .8 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1.2 .35 1.6</size></box></geometry></collision><visual name="v"><geometry><box><size>1.2 .35 1.6</size></box></geometry><material><ambient>.16 .80 .33 1</ambient><diffuse>.16 .80 .33 1</diffuse></material></visual></link></model>
    <model name="charging_station"><static>true</static><pose>2 16 .5 0 0 1.5708</pose><link name="l"><collision name="c"><geometry><box><size>1.0 .35 1.0</size></box></geometry></collision><visual name="v"><geometry><box><size>1.0 .35 1.0</size></box></geometry><material><ambient>.57 .22 .80 1</ambient><diffuse>.57 .22 .80 1</diffuse></material></visual></link></model>
    <model name="dynamic_door"><static>true</static><pose>22.8 14.4 1 0 0 1.5708</pose><link name="l"><collision name="c"><geometry><box><size>1.6 .15 2</size></box></geometry></collision><visual name="v"><geometry><box><size>1.6 .15 2</size></box></geometry><material><ambient>.10 .73 .76 1</ambient><diffuse>.10 .73 .76 1</diffuse></material></visual></link></model>

    <model name="rangermini_2_0" xmlns:ignition="http://ignitionrobotics.org/schema">
      <pose>3 10 .01 0 0 0</pose><link name="base_link"><pose>0 0 .12 0 0 0</pose><gravity>false</gravity>
        <inertial><mass>63</mass><inertia><ixx>1.35</ixx><iyy>2.10</iyy><izz>2.70</izz></inertia></inertial>
        <collision name="body"><geometry><box><size>.738 .500 .20</size></box></geometry></collision>
        <visual name="body"><geometry><box><size>.70 .42 .20</size></box></geometry><material><ambient>.1 .35 .9 1</ambient><diffuse>.1 .35 .9 1</diffuse></material></visual>
        <sensor name="mid360s_proxy" type="gpu_lidar"><pose>.30 0 .58 0 0 0</pose><topic>/scan</topic><update_rate>10</update_rate><lidar><scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan><range><min>.20</min><max>30</max><resolution>.02</resolution></range></lidar></sensor>
        <sensor name="d435i_proxy" type="rgbd_camera"><pose>.34 0 .48 0 0 0</pose><topic>/camera</topic><update_rate>15</update_rate><camera><horizontal_fov>1.396</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>.15</near><far>12</far></clip></camera></sensor>
      </link>
      <plugin filename="libignition-gazebo-velocity-control-system.so" name="ignition::gazebo::systems::VelocityControl"><topic>/model/rangermini_2_0/cmd_vel</topic></plugin>
      <plugin filename="libignition-gazebo-pose-publisher-system.so" name="ignition::gazebo::systems::PosePublisher"><publish_model_pose>true</publish_model_pose><use_pose_vector_msg>false</use_pose_vector_msg><update_frequency>50</update_frequency></plugin>
    </model>
  </world>
</sdf>
