Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic: /robot_description
    - Class: rviz_default_plugins/MarkerArray
      Name: Fused Obstacles
      Enabled: true
      Topic: /fused_obstacles
    - Class: rviz_default_plugins/MarkerArray
      Name: Risk Markers
      Enabled: true
      Topic: /risk_markers
    - Class: rviz_default_plugins/MarkerArray
      Name: Sim People
      Enabled: true
      Topic: /sim/people_markers
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Topic: /odom
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
  Enabled: true
  Global Options:
    Fixed Frame: odom
    Frame Rate: 15
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10.0
      Focal Point: [5, 0, 0]
      Name: Current View
      Pitch: 0.78
      Yaw: 3.14
