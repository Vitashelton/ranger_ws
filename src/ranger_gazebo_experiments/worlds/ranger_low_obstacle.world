<?xml version="1.0"?>
<sdf version="1.6">
  <world name="ranger_low_obstacle">
    <scene>
      <ambient>0.4 0.4 0.4 1.0</ambient>
      <background>0.7 0.8 0.9 1.0</background>
      <shadows>true</shadows>
    </scene>

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <model name="lab_floor">
      <static>true</static>
      <pose>0 0 -0.005 0 0 0</pose>
      <link name="floor_link">
        <visual name="floor_visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.5 0.45 0.4 1.0</ambient><diffuse>0.5 0.45 0.4 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Walls (open space with scattered low obstacles) -->
    <model name="wall_north"><static>true</static><pose>5 3 1.25 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>20 0.15 2.5</size></box></geometry><material><ambient>0.8 0.75 0.7 1.0</ambient></material></visual><collision name="c"><geometry><box><size>20 0.15 2.5</size></box></geometry></collision></link></model>
    <model name="wall_south"><static>true</static><pose>5 -3 1.25 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>20 0.15 2.5</size></box></geometry><material><ambient>0.8 0.75 0.7 1.0</ambient></material></visual><collision name="c"><geometry><box><size>20 0.15 2.5</size></box></geometry></collision></link></model>

    <!-- Dense low obstacles — below MID360S beam height, visible only to D435i depth -->
    <model name="low_cable_bump"><static>true</static><pose>4 0 0.03 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.6 0.08 0.06</size></box></geometry><material><ambient>0.3 0.3 0.3 1.0</ambient></material></visual><collision name="c"><geometry><box><size>0.6 0.08 0.06</size></box></geometry></collision></link></model>

    <model name="low_box_a"><static>true</static><pose>6 0.5 0.08 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.25 0.25 0.16</size></box></geometry><material><ambient>0.9 0.4 0.1 1.0</ambient></material></visual><collision name="c"><geometry><box><size>0.25 0.25 0.16</size></box></geometry></collision></link></model>

    <model name="low_box_b"><static>true</static><pose>8 -0.3 0.1 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.3 0.2 0.2</size></box></geometry><material><ambient>0.8 0.8 0.2 1.0</ambient></material></visual><collision name="c"><geometry><box><size>0.3 0.2 0.2</size></box></geometry></collision></link></model>

    <model name="curb_step"><static>true</static><pose>10 0.8 0.05 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.15 0.4 0.1</size></box></geometry><material><ambient>0.5 0.5 0.5 1.0</ambient></material></visual><collision name="c"><geometry><box><size>0.15 0.4 0.1</size></box></geometry></collision></link></model>

    <model name="low_box_c"><static>true</static><pose>12 0 0.12 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.35 0.35 0.24</size></box></geometry><material><ambient>0.7 0.3 0.3 1.0</ambient></material></visual><collision name="c"><geometry><box><size>0.35 0.35 0.24</size></box></geometry></collision></link></model>

    <model name="low_pallet"><static>true</static><pose>14 -1 0.06 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.5 0.5 0.12</size></box></geometry><material><ambient>0.6 0.45 0.3 1.0</ambient></material></visual><collision name="c"><geometry><box><size>0.5 0.5 0.12</size></box></geometry></collision></link></model>

    <gravity>0 0 -9.8</gravity>
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000.0</real_time_update_rate>
    </physics>
  </world>
</sdf>
