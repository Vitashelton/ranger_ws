Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15.0
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic: /robot_description
    - Class: rviz_default_plugins/PointCloud2
      Name: LiDAR PointCloud
      Enabled: true
      Topic: /livox/lidar
      Style: Points
      Size (Pixels): 2
      Decay Time: 0.2
      Color Transformer: Intensity
    - Class: rviz_default_plugins/Image
      Name: RGB Camera
      Enabled: true
      Topic: /camera/color/image_raw
    - Class: rviz_default_plugins/MarkerArray
      Name: MID360 Obstacles
      Enabled: true
      Topic: /obstacles_mid360
    - Class: rviz_default_plugins/MarkerArray
      Name: D435i Obstacles
      Enabled: true
      Topic: /obstacles_d435i
    - Class: rviz_default_plugins/MarkerArray
      Name: Fused Obstacles
      Enabled: true
      Topic: /fused_obstacles
    - Class: rviz_default_plugins/MarkerArray
      Name: Risk Markers
      Enabled: true
      Topic: /risk_markers
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Topic: /odom
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
  Enabled: true
  Global Options:
    Fixed Frame: odom
    Frame Rate: 30
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10.0
      Focal Point: [5, 0, 0]
      Name: Current View
      Pitch: 0.78
      Yaw: 3.14
