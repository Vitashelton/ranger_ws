Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Cell Size: 1
      Alpha: 0.45
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: FAST-LIO 3D Map
      Topic:
        Value: /Laser_map
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Style: Points
      Size (Pixels): 2
      Size (m): 0.03
      Color Transformer: Intensity
      Position Transformer: XYZ
      Queue Size: 2
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Current Registered Scan
      Topic:
        Value: /cloud_registered
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 2
      Style: Points
      Size (Pixels): 3
      Size (m): 0.04
      Color Transformer: FlatColor
      Color: 255; 80; 20
      Position Transformer: XYZ
      Queue Size: 3
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: FAST-LIO Path
      Topic:
        Value: /path
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Line Style: Lines
      Line Width: 0.04
      Color: 25; 255; 0
      Buffer Length: 1
  Enabled: true
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: mapping_view
    Frame Rate: 20
  Name: Ranger FAST-LIO 3D Mapping
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: 3D Orbit
      Distance: 20
      Target Frame: <Fixed Frame>
Window Geometry:
  Height: 900
  Width: 1450
