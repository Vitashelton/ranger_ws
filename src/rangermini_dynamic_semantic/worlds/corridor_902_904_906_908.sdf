      <plugin filename="libignition-gazebo-pose-publisher-system.so" name="ignition::gazebo::systems::PosePublisher"><publish_model_pose>true</publish_model_pose><use_pose_vector_msg>false</use_pose_vector_msg><update_frequency>10</update_frequency></plugin>
    </model>

    <!-- Navigation-level Ranger Mini 2.0 abstraction.
         This is deliberately NOT a wheel-contact / steering dynamics model.
         The single rigid body keeps the real footprint and sensor mounting;
         VelocityControl realizes body-frame vx, vy and wz for repeatable
         task-navigation experiments. Real 4WS execution belongs to ranger_ros2. -->
    <model name="rangermini_2_0" xmlns:ignition="http://ignitionrobotics.org/schema">
      <pose>1.2 2.3 0.01 0 0 0</pose>
      <link name="base_link">
        <pose>0 0 0.12 0 0 0</pose>
        <gravity>false</gravity>
        <inertial>
          <mass>63.0</mass>
          <inertia><ixx>1.35</ixx><iyy>2.10</iyy><izz>2.70</izz></inertia>
        </inertial>
        <collision name="body_collision">
          <!-- Overall Ranger Mini 2.0 footprint: 738 mm x 500 mm. -->
          <geometry><box><size>0.738 0.500 0.20</size></box></geometry>
        </collision>
        <visual name="body"><geometry><box><size>0.70 0.42 0.20</size></box></geometry>
        <material><ambient>0.1 0.35 0.9 1</ambient><diffuse>0.1 0.35 0.9 1</diffuse></material></visual>
        <!-- Wheels are visualization only. They do not claim to reproduce the
             four independent steering / suspension contact dynamics. -->
        <visual name="front_left_wheel"><pose>0.247 0.182 -0.015 1.5708 0 0</pose><geometry><cylinder><radius>0.105</radius><length>0.075</length></cylinder></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
        <visual name="front_right_wheel"><pose>0.247 -0.182 -0.015 1.5708 0 0</pose><geometry><cylinder><radius>0.105</radius><length>0.075</length></cylinder></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
        <visual name="rear_left_wheel"><pose>-0.247 0.182 -0.015 1.5708 0 0</pose><geometry><cylinder><radius>0.105</radius><length>0.075</length></cylinder></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
        <visual name="rear_right_wheel"><pose>-0.247 -0.182 -0.015 1.5708 0 0</pose><geometry><cylinder><radius>0.105</radius><length>0.075</length></cylinder></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
        <visual name="lidar"><pose>0.30 0 0.35 0 0.523599 0</pose>
        <geometry><cylinder><radius>0.09</radius><length>0.08</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
        <sensor name="mid360s_proxy" type="gpu_lidar">
          <pose>0.30 0 0.35 0 0.523599 0</pose>
          <topic>/scan</topic><update_rate>10</update_rate>
          <lidar><scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan><range><min>0.20</min><max>30.0</max><resolution>0.02</resolution></range></lidar>
        </sensor>
        <sensor name="d435i_proxy" type="rgbd_camera">
          <pose>0.34 0 0.30 0 0 0</pose><topic>/camera</topic><update_rate>15</update_rate>
          <camera><horizontal_fov>1.396</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.15</near><far>12.0</far></clip></camera>
        </sensor>
      </link>

      <plugin filename="libignition-gazebo-velocity-control-system.so"
              name="ignition::gazebo::systems::VelocityControl">
        <topic>/model/rangermini_2_0/cmd_vel</topic>
        <initial_linear>0 0 0</initial_linear>
        <initial_angular>0 0 0</initial_angular>
      </plugin>

      <!-- Independent simulation ground truth. -->
      <plugin filename="libignition-gazebo-pose-publisher-system.so"
              name="ignition::gazebo::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <publish_sensor_pose>false</publish_sensor_pose>
        <publish_model_pose>true</publish_model_pose>
        <publish_nested_model_pose>true</publish_nested_model_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg>
        <update_frequency>50</update_frequency>
      </plugin>
    </model>
  </world>
</sdf>
