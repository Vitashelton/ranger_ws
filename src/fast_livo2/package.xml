<?xml version="1.0"?>
<package format="3">
  <name>fast_livo</name>
  <version>0.0.0</version>

  <description>
    FAST-LIVO / FAST-LIVO2 ROS 2 package for LiDAR-Inertial-Visual Odometry.
  </description>

  <maintainer email="dev@livoxtech.com">claydergc</maintainer>
  <license>BSD</license>

  <author email="zhangji@cmu.edu">Ji Zhang</author>

  <!-- Build tools -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Needed because CMakeLists.txt uses rosidl_get_typesupport_target -->
  <build_depend>rosidl_cmake</build_depend>

  <!-- ROS 2 core dependencies -->
  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_ros</depend>

  <!-- Point cloud / image dependencies -->
  <depend>pcl_ros</depend>
  <depend>pcl_conversions</depend>
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>

  <!-- Livox custom message dependency -->
  <depend>livox_ros_driver2</depend>

  <!-- FAST-LIVO visual frontend dependencies -->
  <depend>vikit_common</depend>
  <depend>vikit_ros</depend>

  <!-- System / library dependencies -->
  <depend>libopencv-dev</depend>
  <depend>libpcl-all-dev</depend>
  <depend>libeigen3-dev</depend>
  <depend>libboost-all-dev</depend>
  <depend>libfmt-dev</depend>

  <!-- Test dependencies -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
