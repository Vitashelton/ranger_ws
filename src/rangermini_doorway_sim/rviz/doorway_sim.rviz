Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/MoveCamera
    Name: MoveCamera

    
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane: XY
      Reference Frame: odom
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
    - Class: rviz_default_plugins/Odometry
      Name: RangerMini odom
      Enabled: true
      Topic:
        Value: /odom
      Shape: Arrow
      Color: 0; 85; 255
    - Class: rviz_default_plugins/Marker
      Name: Robot footprint
      Enabled: true
      Topic:
        Value: /debug/robot_footprint
    - Class: rviz_default_plugins/MarkerArray
      Name: Doorway and risk zones
      Enabled: true
      Topic:
        Value: /debug/doorway_markers
    - Class: rviz_default_plugins/MarkerArray
      Name: Candidate / rejected / selected rollouts
      Enabled: true
      Topic:
        Value: /debug/candidate_paths
    - Class: rviz_default_plugins/Path
      Name: Executed path
      Enabled: true
      Topic:
        Value: /debug/executed_path
      Color: 25; 120; 255
  Global Options:
    Fixed Frame: odom
  Name: root
