<?xml version="1.0"?>
<!--
  ranger_mini_sim.urdf.xacro — Gazebo simulation model for Ranger Mini 2.0

  Approximates: Ranger Mini 2.0 chassis (~0.85 x 0.58 x 0.40 m)
  Sensors (matching real install):
    - MID360S LiDAR at base_link (0.30, 0, 0.70) with 30° pitch tilt → livox_frame
    - D435i RGB-D at base_link (0.35, 0, 0.60) forward-facing → camera_link
    - IMU at base_link origin
  Drive: skid-steer approximated via diff-drive plugin

  Frame tree:
    odom → base_link → livox_frame (LiDAR)
                     → camera_link → camera_color_optical_frame
                                  → camera_depth_optical_frame
                     → imu_link
                     → wheel_{front,rear}_{left,right}_link
-->
<robot name="ranger_mini_sim" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========== Constants ========== -->
  <xacro:property name="chassis_length" value="0.85"/>
  <xacro:property name="chassis_width" value="0.58"/>
  <xacro:property name="chassis_height" value="0.40"/>
  <xacro:property name="wheel_radius" value="0.15"/>
  <xacro:property name="wheel_width" value="0.08"/>
  <xacro:property name="wheel_x_offset" value="0.30"/>
  <xacro:property name="wheel_y_offset" value="0.35"/>
  <xacro:property name="wheel_z_offset" value="-0.12"/>
  <xacro:property name="lidar_x" value="0.30"/>
  <xacro:property name="lidar_y" value="0.0"/>
  <xacro:property name="lidar_z" value="0.70"/>
  <xacro:property name="lidar_pitch" value="0.523599"/>  <!-- 30 degrees -->
  <xacro:property name="camera_x" value="0.35"/>
  <xacro:property name="camera_y" value="0.0"/>
  <xacro:property name="camera_z" value="0.60"/>

  <!-- ========== Materials ========== -->
  <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
  <material name="dark_grey"><color rgba="0.3 0.3 0.3 1.0"/></material>
  <material name="grey"><color rgba="0.5 0.5 0.5 1.0"/></material>
  <material name="orange"><color rgba="1.0 0.5 0.0 1.0"/></material>
  <material name="blue"><color rgba="0.0 0.3 0.8 1.0"/></material>
  <material name="silver"><color rgba="0.75 0.75 0.8 1.0"/></material>

  <!-- ========== Base Footprint ========== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ========== Chassis (base_link) ========== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <visual>
      <!-- Top plate / sensor bar -->
      <origin xyz="0.15 0 ${chassis_height + 0.02}" rpy="0 0 0"/>
      <geometry>
        <box size="0.40 0.08 0.04"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="50.0"/>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <inertia ixx="2.0" ixy="0" ixz="0" iyy="3.0" iyz="0" izz="3.0"/>
    </inertial>
  </link>

  <!-- ========== Wheels ========== -->
  <xacro:macro name="wheel" params="name prefix x y z">
    <link name="${prefix}_${name}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 ${pi/2} 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 ${pi/2} 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="1.5"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/>
      </inertial>
    </link>

    <joint name="${prefix}_${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_${name}_wheel_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel name="front_left"  prefix="fl" x="${wheel_x_offset}"  y="${wheel_y_offset}"  z="${wheel_z_offset}"/>
  <xacro:wheel name="front_right" prefix="fr" x="${wheel_x_offset}"  y="${-wheel_y_offset}" z="${wheel_z_offset}"/>
  <xacro:wheel name="rear_left"   prefix="rl" x="${-wheel_x_offset}" y="${wheel_y_offset}"  z="${wheel_z_offset}"/>
  <xacro:wheel name="rear_right"  prefix="rr" x="${-wheel_x_offset}" y="${-wheel_y_offset}" z="${wheel_z_offset}"/>

  <!-- ========== Livox MID360S LiDAR Frame ========== -->
  <link name="livox_frame">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.08"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="livox_joint" type="fixed">
    <parent link="base_link"/>
    <child link="livox_frame"/>
    <origin xyz="${lidar_x} ${lidar_y} ${lidar_z}" rpy="0 ${lidar_pitch} 0"/>
  </joint>

  <!-- ========== D435i Camera ========== -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.09 0.025 0.025"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${camera_x} ${camera_y} ${camera_z}" rpy="0 0 0"/>
  </joint>

  <!-- Camera optical frames — standard ROS convention: z forward, x right, y down -->
  <link name="camera_color_optical_frame"/>
  <joint name="camera_color_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <link name="camera_depth_optical_frame"/>
  <joint name="camera_depth_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- ========== IMU ========== -->
  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- ========== Gazebo Plugins ========== -->

  <!-- Diff Drive -->
  <gazebo>
    <plugin name="diff_drive_controller" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <update_rate>50.0</update_rate>
      <left_joint>fl_front_left_wheel_joint</left_joint>
      <left_joint>rl_rear_left_wheel_joint</left_joint>
      <right_joint>fr_front_right_wheel_joint</right_joint>
      <right_joint>rr_rear_right_wheel_joint</right_joint>
      <wheel_separation>${wheel_y_offset * 2}</wheel_separation>
      <wheel_diameter>${wheel_radius * 2}</wheel_diameter>
      <max_wheel_torque>50.0</max_wheel_torque>
      <max_wheel_acceleration>10.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <publish_odom>true</publish_odom>
      <publish_distance>true</publish_distance>
      <odom_topic>odom</odom_topic>
    </plugin>
  </gazebo>

  <!-- MID360S Simulated 3D LiDAR — outputs PointCloud2, NEVER LaserScan -->
  <gazebo reference="livox_frame">
    <sensor name="mid360s_sim" type="ray">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>10.0</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.0</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1.0</resolution>
            <min_angle>-0.35</min_angle>
            <max_angle>0.35</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.15</min>
          <max>40.0</max>
          <resolution>0.02</resolution>
        </range>
      </ray>
      <plugin name="gazebo_ros_mid360s_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/livox</namespace>
          <remapping>~/out:=lidar</remapping>
        </ros>
        <output_type>sensor_msgs/PointCloud2</output_type>
        <frame_name>livox_frame</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- D435i RGB Camera on color optical frame -->
  <gazebo reference="camera_color_optical_frame">
    <sensor name="d435i_rgb" type="camera">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>30.0</update_rate>
      <camera>
        <horizontal_fov>1.089</horizontal_fov>  <!-- ~62.5 deg horizontal for 640px -->
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>10.0</far>
        </clip>
      </camera>
      <plugin name="d435i_rgb_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/camera/color</namespace>
          <remapping>~/image_raw:=image_raw</remapping>
          <remapping>~/camera_info:=camera_info</remapping>
        </ros>
        <frame_name>camera_color_optical_frame</frame_name>
        <update_rate>30.0</update_rate>
        <camera_info_topic>camera_info</camera_info_topic>
      </plugin>
    </sensor>
  </gazebo>

  <!-- D435i Depth Camera — outputs depth image + pointcloud -->
  <gazebo reference="camera_depth_optical_frame">
    <sensor name="d435i_depth" type="depth">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>30.0</update_rate>
      <camera>
        <horizontal_fov>1.089</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
      </camera>
      <plugin name="d435i_depth_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/camera/depth</namespace>
          <remapping>~/image_raw:=image_raw</remapping>
          <remapping>~/camera_info:=camera_info</remapping>
          <remapping>~/points:=color/points</remapping>
        </ros>
        <frame_name>camera_depth_optical_frame</frame_name>
        <update_rate>30.0</update_rate>
        <camera_info_topic>camera_info</camera_info_topic>
        <hack_baseline>0.05</hack_baseline>
      </plugin>
    </sensor>
  </gazebo>

  <!-- IMU -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <pose>0 0 0 0 0 0</pose>
      <update_rate>100.0</update_rate>
      <plugin name="imu_controller" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=imu</remapping>
        </ros>
        <frame_name>imu_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Joint state publisher plugin -->
  <gazebo>
    <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <namespace>/</namespace>
        <remapping>~/out:=joint_states</remapping>
      </ros>
      <update_rate>50.0</update_rate>
      <joint_name>fl_front_left_wheel_joint</joint_name>
      <joint_name>fr_front_right_wheel_joint</joint_name>
      <joint_name>rl_rear_left_wheel_joint</joint_name>
      <joint_name>rr_rear_right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

</robot>
