<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="rangermini_simplified">

  <xacro:property name="base_length" value="0.82"/>
  <xacro:property name="base_width" value="0.62"/>
  <xacro:property name="base_height" value="0.22"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.11" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="ranger_blue">
        <color rgba="0.1 0.35 0.9 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.11" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
  </link>

  <link name="mid360s_link">
    <visual>
      <origin xyz="0 0 0.28" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.08"/>
      </geometry>
      <material name="black">
        <color rgba="0.02 0.02 0.02 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="mid360s_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mid360s_link"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/>
  </joint>

  <link name="d435i_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.22 0.07"/>
      </geometry>
      <material name="camera_black">
        <color rgba="0.0 0.0 0.0 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="d435i_joint" type="fixed">
    <parent link="base_link"/>
    <child link="d435i_link"/>
    <origin xyz="0.42 0 0.22" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="wheel_visual" params="name x y">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="0.09" length="0.055"/>
        </geometry>
        <material name="wheel_dark">
          <color rgba="0.05 0.05 0.05 1.0"/>
        </material>
      </visual>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} 0.05" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel_visual name="front_left_wheel"  x="0.28"  y="0.25"/>
  <xacro:wheel_visual name="front_right_wheel" x="0.28"  y="-0.25"/>
  <xacro:wheel_visual name="rear_left_wheel"   x="-0.28" y="0.25"/>
  <xacro:wheel_visual name="rear_right_wheel"  x="-0.28" y="-0.25"/>

</robot>
